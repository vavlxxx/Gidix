APP_NAME=GIDIX
DATABASE_URL=postgresql+psycopg2://gidix:gidix_password@localhost:5432/gidix
JWT_SECRET=change_me
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=admin123
OSRM_BASE_URL=http://localhost:5000
OSRM_PROFILE=foot
OSRM_TIMEOUT_SECONDS=30
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT_SECONDS=90
OSM_USER_AGENT=GidixDiploma/1.0 contact@example.com
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:latest
LLM_TIMEOUT_SECONDS=120
ENABLE_ROUTE_GENERATION=true
ENABLE_LLM_DESCRIPTION=true
ENABLE_OSM_IMPORT=true
ENABLE_PAYMENTS_MOCK=true
ROUTE_OPTIMIZATION_DEFAULT=nearest_neighbor_2opt
ROUTE_OPTIMIZATION_MAX_HELD_KARP_POINTS=16
ROUTE_OPTIMIZATION_MAX_BRUTEFORCE_POINTS=10
