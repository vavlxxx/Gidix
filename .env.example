# App
APP_NAME=GIDIX
NODE_ENV=development
APP_PORT=3000
API_PORT=8000
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000

# Database
POSTGRES_DB=gidix
POSTGRES_USER=gidix
POSTGRES_PASSWORD=gidix_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://gidix:gidix_password@postgres:5432/gidix

# Auth
JWT_SECRET=change_me
SESSION_SECRET=change_me
PASSWORD_SALT_ROUNDS=10

# OSRM
OSRM_BASE_URL=http://osrm:5000
OSRM_PROFILE=foot
OSRM_TIMEOUT_SECONDS=30

# Overpass / OSM
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT_SECONDS=90
OSM_USER_AGENT=GidixDiploma/1.0 contact@example.com

# Local LLM
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=gemma3:latest
LLM_TIMEOUT_SECONDS=120

# Feature flags
ENABLE_ROUTE_GENERATION=true
ENABLE_LLM_DESCRIPTION=true
ENABLE_OSM_IMPORT=true
ENABLE_PAYMENTS_MOCK=true

# Route optimization
ROUTE_OPTIMIZATION_DEFAULT=nearest_neighbor_2opt
ROUTE_OPTIMIZATION_MAX_HELD_KARP_POINTS=16
ROUTE_OPTIMIZATION_MAX_BRUTEFORCE_POINTS=10
