APP_NAME=GIDIX
NODE_ENV=development
APP_MODE=DEV

APP_PORT=3000
API_PORT=8000

PUBLIC_APP_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000
VITE_API_BASE=http://localhost:8000

POSTGRES_DB=gidix
POSTGRES_USER=gidix
POSTGRES_PASSWORD=gidix_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://gidix:gidix_password@postgres:5432/gidix

JWT_SECRET=change_me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_SALT_ROUNDS=12

MEDIA_DIR=/app/media
LOGS_DIR=/app/logs
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

ENABLE_ROUTE_GENERATION=true
OSRM_BASE_URL=http://osrm:5000
OSRM_PROFILE=foot
OSRM_TIMEOUT_SECONDS=30
ROUTE_OPTIMIZATION_DEFAULT=nearest_neighbor_2opt
ROUTE_OPTIMIZATION_MAX_BRUTEFORCE_POINTS=10
ROUTE_OPTIMIZATION_MAX_HELD_KARP_POINTS=16

ENABLE_LLM_DESCRIPTION=true
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma3:latest
LLM_TIMEOUT_SECONDS=120

ENABLE_WEB_FACT_SEARCH=true
WIKIPEDIA_LANGUAGE=ru
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT_SECONDS=90
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OSM_USER_AGENT=GidixDiploma/1.0 contact@example.com

ENABLE_OSM_IMPORT=true
ENABLE_PAYMENTS_MOCK=true

VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_ATTRIBUTION=© OpenStreetMap contributors
VITE_PLACEHOLDER_IMAGE=https://placehold.co/600x400/EEE/31343C
